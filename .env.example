# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template konfigurasi CLV Music Bot Web Panel
# Salin file ini menjadi .env lalu isi dengan nilai yang sesuai.
# JANGAN commit file .env asli ke git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Web Server ────────────────────────────────────────────────────────────────

# Port yang digunakan Web Dashboard
PORT=24601

# ── Database MySQL ─────────────────────────────────────────────────────────────

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ── Session ────────────────────────────────────────────────────────────────────

# Ganti dengan string acak yang panjang dan unik (minimal 32 karakter)
SESSION_SECRET=change_me_to_a_long_random_secret_string

# ── Discord Bot Configuration ──────────────────────────────────────────────────

# Bot 1
BOT_1_TOKEN=your_bot_1_discord_token
BOT_1_GUILD_ID=your_guild_id
BOT_1_VOICE_CHANNEL_ID=your_voice_channel_id

# Bot 2 (opsional, hapus jika tidak digunakan)
# BOT_2_TOKEN=your_bot_2_discord_token
# BOT_2_GUILD_ID=your_guild_id
# BOT_2_VOICE_CHANNEL_ID=your_voice_channel_id_2

# ── Gemini AI (opsional) ───────────────────────────────────────────────────────

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# ── Music Bot Settings ─────────────────────────────────────────────────────────

MUSIC_PREFIX=!
OWNER_IDS=your_discord_user_id
DEFAULT_VOLUME=100
IDLE_TIMEOUT=60

# ── GitHub Webhook (opsional, untuk auto-deploy) ───────────────────────────────

WEBHOOK_PORT=24601
WEBHOOK_SECRET=change_me_to_a_random_webhook_secret
WEBHOOK_BRANCH=main

# ── Domain Access Restriction Guard ───────────────────────────────────────────
#
# Fitur keamanan untuk membatasi akses Web Panel hanya dari 1 domain utama.
# Seluruh akses dari IP langsung (http://IP:PORT) atau domain lain akan
# diblokir total dengan respons 403 Access Denied.
#
# Cara mengaktifkan:
#   1. Set ALLOWED_DOMAINS_ENABLED=true
#   2. Isi ALLOWED_DOMAINS dengan domain panel Anda (tanpa http:// dan tanpa port)
#      Contoh: panel.domainanda.com
#   3. Restart server
#
# PERHATIAN: Pastikan domain yang Anda isi adalah domain yang sedang Anda gunakan
# untuk mengakses panel ini. Jika salah isi, Anda akan terkunci dari panel!
#
ALLOWED_DOMAINS_ENABLED=false
ALLOWED_DOMAINS=
